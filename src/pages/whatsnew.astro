---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Build {
  build: string;
  date: string;
  /** Optional lead-in shown before the bullet list. */
  note?: string;
  changes: string[];
}

interface Version {
  name: string;
  builds: Build[];
}

