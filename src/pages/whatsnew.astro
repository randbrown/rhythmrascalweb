---

<BaseLayout title="Version History" description="Rhythm Rascal version history and release notes, from version 1.0 in 2004 through version 3.4.">
  <h3>Version History</h3>
  {
    history.map((version) => (
      <section>
        <h3>{version.name}</h3>
        {version.builds.map((b) => (
          <>
            <p>
              Build {b.build} ({b.date})
            </p>
            <ul>
              {b.changes.map((c) => <li set:html={c} />)}
            </ul>
          </>
        ))}
      </section>
    ))
  }
</BaseLayout>
